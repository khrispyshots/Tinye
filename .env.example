# PUBLIC FRONTEND CONFIGURATION
# Tinye uses Next.js. NEXT_PUBLIC_* values are public browser configuration.
# Do not put secrets in any NEXT_PUBLIC_* variable.
NEXT_PUBLIC_NEAR_NETWORK_ID=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_EXPLORER_URL=https://testnet.nearblocks.io

# Fill in only after the corresponding deployment has been verified.
# A blank value means unavailable; never fall back to a fabricated contract.
NEXT_PUBLIC_TINYE_SAVINGS_CONTRACT=
NEXT_PUBLIC_TINYE_REWARDS_CONTRACT=

# PRIVATE DEPLOYMENT CONFIGURATION
# Deployment tooling only. Never import these into frontend code.
NEAR_DEPLOYER_ACCOUNT_ID=
NEAR_CREDENTIALS_PATH=
NEAR_SIGNING_METHOD=keychain

# Prefer OS keychain or a protected secret store.
# Only use if the selected deployment tool explicitly requires it.
# NEAR_DEPLOYER_PRIVATE_KEY=

# Server-side allowed origin for authentication; set exact HTTPS origin when hosted.
TINYE_APP_ORIGIN=http://127.0.0.1:3010,http://localhost:3000

# Supabase browser configuration (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase backend configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Server only. Set the full value locally; never use NEXT_PUBLIC_ for this key.
SUPABASE_SECRET_KEY=
# Management token used only by scripts/supabase-migrate.mjs, never by frontend.
SUPABASE_ACCESS_TOKEN=

# Local embedded-wallet sponsor (testnet only; credentials remain in OS keychain).
TINYE_EMBEDDED_SPONSOR_ENABLED=false
TINYE_EMBEDDED_SPONSOR_ACCOUNT=tinye.testnet
TINYE_NEAR_CLI_PATH=
NEXT_PUBLIC_NEAR_AUTH_CLIENT_ID=np8paqIpMWmNbzT4xAvOOapZBjsOpptl
# Enable only after the group extension deployment and checks are verified.
NEXT_PUBLIC_TINYE_GROUPS_ENABLED=false
